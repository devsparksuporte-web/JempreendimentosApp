{
  "expo": {
    "name": "JEmpreendimentos",
    "slug": "jempreendimentosapp",
    "owner": "devsparksuporte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jempreendimentos",
    "userInterfaceStyle": "light",
    "locales": {},
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "br.com.jempreendimentos.app"
    },
    "android": {
      "package": "br.com.jempreendimentos.app",
      "adaptiveIcon": {
        "backgroundColor": "#06152E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#06152E",
      "backgroundColor": "#F4F8FF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para ler QR Codes e registrar fotos do atendimento."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06152E",
          "image": "./assets/images/brand/jempreendimentos-logo.png",
          "imageWidth": 280
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d07c1c26-b3b9-440a-8478-b0a252faea90"
      }
    }
  }
}
