# Supabase — Project Settings > API
# A anon key é pública por design (protegida por Row Level Security).
# A service_role key NUNCA entra no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Mapbox — token público com escopo somente para mapas/tiles
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.seu-token-publico-mapbox
