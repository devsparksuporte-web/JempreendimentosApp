# Supabase — Project Settings > API
# A anon key é pública por design (protegida por Row Level Security).
# A service_role key NUNCA entra no app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Mapbox — são DOIS tokens diferentes, ambos em account.mapbox.com
#
# 1) Público (pk.): usado em execução para carregar os tiles do mapa.
#    Vai embutido no app, como a anon key do Supabase.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.seu-token-publico-mapbox
#
# 2) De download (sk. com escopo DOWNLOADS:READ): usado só em tempo de BUILD,
#    porque o SDK Android do Mapbox fica num repositório Maven privado.
#    É SECRETO — nunca comitar. Sem ele o Gradle falha ao baixar o SDK.
#    No EAS, cadastre como secret em vez de arquivo:
#      eas env:create --name MAPBOX_DOWNLOAD_TOKEN --scope project --visibility secret
MAPBOX_DOWNLOAD_TOKEN=sk.seu-token-de-download
